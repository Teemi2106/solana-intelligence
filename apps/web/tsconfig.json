{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": false,
    "noEmit": true
  },
  "references": [
    {
      "path": "../../packages/config"
    },
    {
      "path": "../../packages/db"
    },
    {
      "path": "../../packages/queue"
    },
    {
      "path": "../../packages/ingestion"
    },
    {
      "path": "../../packages/blockchain"
    },
    {
      "path": "../../packages/observability"
    },
    {
      "path": "../../packages/domain"
    }
  ],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
