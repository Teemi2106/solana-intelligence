# PostgreSQL connection string. Required by web and workers.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/solana_intelligence
# Redis connection string. Required by workers and asynchronous web operations.
REDIS_URL=redis://localhost:6379
# Public canonical origin, without a trailing slash.
APP_URL=http://localhost:3000
# At least 32 random bytes, encoded as base64. Used to sign dashboard sessions.
AUTH_SECRET=
# Private dashboard username and an Argon2id password hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Helius API key is required for historical wallet ingestion.
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
# Public HTTPS URL Helius posts webhooks to (required when ENABLE_LIVE_INGESTION=true; localhost is rejected by Helius).
LIVE_WEBHOOK_PUBLIC_URL=

# Optional Sentry-compatible DSN.
SENTRY_DSN=
# Structured log threshold: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
# Runtime switches permit a safe foundation-only deployment.
ENABLE_LIVE_INGESTION=false
ENABLE_TELEGRAM=false

# Telegram credentials are required when delivery is enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
