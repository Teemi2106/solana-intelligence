# PostgreSQL connection string. Required by web and workers.
DATABASE_URL=
# Redis connection string. Required by workers and asynchronous web operations.
REDIS_URL=redis://localhost:6379
# Public canonical origin, without a trailing slash.
APP_URL=http://localhost:3000
# At least 32 random bytes, encoded as base64. Used to sign dashboard sessions.
AUTH_SECRET=
# Private dashboard username and an Argon2id password hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Helius API key is required for historical wallet ingestion.
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
# Public HTTPS URL Helius posts webhooks to (required when ENABLE_LIVE_INGESTION=true; localhost is rejected by Helius).
LIVE_WEBHOOK_PUBLIC_URL=

# Optional Sentry-compatible DSN.
SENTRY_DSN=
# Structured log threshold: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
# Runtime switches permit a safe foundation-only deployment.
ENABLE_LIVE_INGESTION=false
ENABLE_TELEGRAM=false
RECOVERY_INTEGRITY_INTERVAL_HOURS=24
# Keep true until shadow results prove checkpoint recovery is equivalent to the legacy hourly scanner.
RECOVERY_SHADOW_MODE=true

# Phase 4 is event/request-driven: these values are freshness gates, not polling intervals.
ENABLE_TOKEN_INTELLIGENCE=false
TOKEN_MARKET_FRESHNESS_MINUTES=5
TOKEN_HOLDER_FRESHNESS_HOURS=24
TOKEN_METADATA_FRESHNESS_HOURS=24
TOKEN_AUTHORITIES_FRESHNESS_HOURS=6

# Finalized-only, event-driven wallet behavioral anomaly evaluation. Build baselines manually before enabling.
ENABLE_BEHAVIOR_ANOMALIES=false
# Internal evaluation only. Persists shadow results but cannot create incidents or notifications.
ENABLE_BEHAVIOR_SHADOW_EVALUATION=false
BEHAVIOR_RECENT_WINDOW_DAYS=30
BEHAVIOR_LONG_TERM_WINDOW_DAYS=180
BEHAVIOR_MAX_OBSERVATIONS=2000
BEHAVIOR_INCIDENT_WINDOW_MINUTES=30

# Telegram credentials are required when delivery is enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
