{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "inputs": [
        {
          "local": true,
          "include": [
            "package.json",
            "package-lock.json",
            ".npmrc",
            "apps/*/package.json",
            "packages/*/package.json"
          ]
        }
      ],
      "commands": [
        "npm i -g corepack@latest",
        "corepack enable",
        "corepack prepare npm@11.6.0 --activate",
        "npm ci"
      ]
    },
    "build": {
      "inputs": [
        {
          "step": "install"
        }
      ],
      "commands": ["npm run build"]
    }
  },
  "deploy": {
    "startCommand": "npm run start --workspace @swi/worker"
  }
}
