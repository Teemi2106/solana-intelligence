{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "commands": [
        "npm install --global npm@11.6.0 && npm --version && test \"$(npm --version)\" = \"11.6.0\" && npm ci"
      ]
    },
    "build": {
      "commands": ["npm run build"]
    }
  },
  "deploy": {
    "startCommand": "npm run start --workspace @swi/worker"
  }
}
